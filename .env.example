# ---------------------------------------------------------------------------
# Mibbi environment variables. Copy to .env.local for development.
# Never commit .env.local. Vercel: set these in Project Settings → Environment.
# ---------------------------------------------------------------------------

# Public (shipped to the browser). The anon key is safe to expose: Row Level
# Security in Postgres is what protects data, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets.
# Service role bypasses RLS. Used only by admin tooling on the server.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pepper for hashing adoption codes (HMAC-SHA256). Changing this invalidates
# every code already generated, so generate it once and back it up securely.
# Local development uses the value below so the seeded demo codes work.
ADOPTION_CODE_PEPPER=dev-pepper-change-me

# Used only by scripts/gen-types.mjs and tests/db/run.sh (local Postgres).
# DATABASE_URL=postgres://postgres@localhost:5432/postgres
